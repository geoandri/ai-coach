# AI Coach Standalone — Environment Variables

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000
DATABASE_PATH=./data/ai_coach.db

# ── intervals.icu (optional) ───────────────────────────────────────────────
# Used for the initial activity import during new athlete onboarding.
# The coach will ask the athlete if they want to import their history; if they
# agree, the server uses these credentials to sync and then stores them
# permanently in the database — so this only needs to be set once.
# Find Athlete ID (e.g. i12345) and API Key at https://intervals.icu/settings → API Access.
INTERVALS_ICU_ATHLETE_ID=
INTERVALS_ICU_API_KEY=

# ── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000

# ── MCP Server ─────────────────────────────────────────────────────────────
MCP_PORT=3001
